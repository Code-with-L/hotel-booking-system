{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci --workspace=@stillhouse/web --include=dev"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "cd ../.. && npm ci --workspace=@stillhouse/api",
      "buildCommand": "cd ../.. && npx prisma generate"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "functions": {
    "apps/api/src/app.js": {
      "includeFiles": "apps/api/src/generated/prisma/**"
    }
  }
}
