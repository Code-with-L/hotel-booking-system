# Copy to .env and fill in. Never commit .env. Never put real secrets in this file.

# --- Database (M3+) ---
DATABASE_URL=postgresql://stillhouse:change-me@localhost:5432/stillhouse?schema=public
MIGRATION_DATABASE_URL=postgresql://stillhouse_migrations:change-me@localhost:5432/stillhouse?schema=public

# --- Sessions (M3+) ---
SESSION_SECRET=generate-a-long-random-string
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_LIFETIME_DAYS=7

# --- Web (M1+) ---
# VITE_API_BASE_URL=http://localhost:4000/api/v1   (dev proxy used instead by default)

# --- Email (M5+) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="The Stillhouse <reservations@example.com>"

# --- M-Pesa Daraja (M5+) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-host.example/api/v1/webhooks/mpesa

# --- Card provider (later) ---
# CARD_PROVIDER=
# CARD_PROVIDER_SECRET_KEY=
