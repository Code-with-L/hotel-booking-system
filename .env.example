# Copy to .env and fill in. Never commit .env. Never put real secrets in this file.

# --- Database ---
DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5432/stillhouse?schema=public
# Test database (optional; used by the API test suite on :5433)
TEST_DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5433/stillhouse_test?schema=public
TEST_ADMIN_DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5433/postgres

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Sessions ---
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_LIFETIME_DAYS=7

# --- Rate limiting (defaults shown) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Email (optional; without it, reset-by-email returns 503) ---
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=The Stillhouse <reservations@example.com>

# --- M-Pesa Daraja (STK push) ---
# MPESA_ENV=disabled|sandbox|production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-host.example/api/v1/webhooks/mpesa
# MPESA_WEBHOOK_ALLOWED_IPS=

# --- Development seed credentials (remove/change for any real deployment) ---
# SEED_ADMIN_EMAIL=admin@thestillhouse.example
# SEED_ADMIN_PASSWORD=StillhouseAdmin!26
# SEED_MANAGER_EMAIL=manager@thestillhouse.example
# SEED_MANAGER_PASSWORD=StillhouseManager!26
# SEED_GUEST_EMAIL=naomi.achieng@example.com
# SEED_GUEST_PASSWORD=GuestPassword!26

# --- Web ---
# Same-origin /api proxy is used by default (see apps/web/vite.config.js).
# VITE_API_BASE_URL=http://localhost:4000/api/v1
