# Copy to .env and fill in. NEVER commit .env. Names only in this file.
# Production refuses to boot unless SESSION_SECRET is ≥ 32 random bytes, COOKIE_SECURE=true, and WEB_ORIGIN is https://.

# --- Database ---
DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5432/stillhouse?schema=public
TEST_DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5433/stillhouse_test?schema=public
TEST_ADMIN_DATABASE_URL=postgresql://stillhouse:stillhouse_dev_password@localhost:5433/postgres
# Production: a managed PostgreSQL connection string (non-DDL app role).

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173          # production: https://your-domain (REQUIRED https in prod)
FRONTEND_BASE_URL=http://localhost:5173   # production: https://your-domain (used in password-reset links)
TRUST_PROXY=1                             # hops in front of the API (nginx/LB = 1)

# --- Sessions ---
SESSION_SECRET=dev-only-not-a-secret-change-me-in-production-0000000000  # production: ≥ 32 random bytes
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_LIFETIME_DAYS=7
COOKIE_SECURE=false                       # production: MUST be true

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PUBLIC_READ_RATE_MAX=180          # availability/catalogue reads per 15 min (429 beyond)
PUBLIC_WRITE_RATE_MAX=60          # reservation/payment/enquiry writes per 15 min (429 beyond)
JOB_TOKEN=                        # when set, GET /api/v1/jobs/health requires: Authorization: Bearer <JOB_TOKEN> (monitoring probe)

# --- Logging ---
LOG_LEVEL=info

# --- Email (optional; without these, emails record as 'skipped' in email_outbox) ---
# EMAIL_PROVIDER=smtp
# EMAIL_SMTP_HOST=smtp.mailgun.org
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false                 # true only for SMTP 465
# EMAIL_SMTP_USER=postmaster@yourdomain
# EMAIL_SMTP_PASS=
# EMAIL_FROM=The Stillhouse <reservations@yourdomain>
# ADMIN_NOTIFICATION_EMAIL=reservations@yourdomain   # new-booking alerts

# --- M-Pesa Daraja ---
# MPESA_ENV=disabled               # disabled | sandbox | production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379           # sandbox test shortcode
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://yourdomain/api/v1/webhooks/mpesa
# MPESA_WEBHOOK_ALLOWED_IPS=       # optional Daraja callback IP allowlist

# --- eTIMS (KRA) — activation is owner-gated; see docs/ACTIVATE_ETIMS.md ---
# ETIMS_ENVIRONMENT=disabled       # disabled | mock | sandbox | production
# ETIMS_TIN=P000000000A
# ETIMS_BRANCH_ID=00
# ETIMS_DEVICE_SERIAL=
# ETIMS_BASE_URL=
# ETIMS_COMMUNICATION_KEY=
# ETIMS_SALES_INVOICE_PATH=        # from the OSCU specification after KRA sandbox registration

# --- Production seeding (REQUIRED to create staff users in production) ---
# SEED_ADMIN_EMAIL=admin@yourdomain
# SEED_ADMIN_PASSWORD=<strong-random>
# SEED_MANAGER_EMAIL=manager@yourdomain
# SEED_MANAGER_PASSWORD=<strong-random>
# SEED_GUEST_EMAIL=naomi.achieng@example.com
# SEED_GUEST_PASSWORD=<strong-random>

# --- Web ---
# Same-origin /api proxy is used by default (apps/web/vite.config.js).
# VITE_API_BASE_URL=http://localhost:4000/api/v1
