# The Stillhouse — STAGING environment variables (names only).
# Copy to `.env.staging` and fill with staging-only values. NEVER commit `.env.staging`.
# Staging must never share a database with development or production.
# Secrets: inject via your CI secret store / password manager / openssl rand. Never paste into chat or git.

# --- Staging database (separate from dev and prod by design) ---
STAGING_DB_PASSWORD=                 # random, e.g. openssl rand -hex 24

# --- Application security ---
STAGING_SESSION_SECRET=              # >= 32 random bytes, e.g. openssl rand -hex 32

# --- Origins (TLS required in staging; cookie secure is enforced by config) ---
STAGING_WEB_ORIGIN=https://staging.stillhouse.local   # or your real staging domain

# --- Rehearsal-only seed users (fake addresses; used only with the "rehearsal" profile) ---
STAGING_SEED_ADMIN_PASSWORD=         # random; known only to the rehearsal operator
STAGING_SEED_MANAGER_PASSWORD=
STAGING_SEED_GUEST_PASSWORD=

# --- Integrations: leave disabled until the owner verifies them (see docs/STAGING.md) ---
# MPESA_ENV=disabled                 # disabled|sandbox|production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=                   # sandbox: 174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=                # must be https://<staging-domain>/api/v1/webhooks/mpesa
# EMAIL_PROVIDER=smtp                # omit or empty = emails recorded as skipped, never sent
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=The Stillhouse <reservations@staging.example.com>
# ADMIN_NOTIFICATION_EMAIL=          # e.g. hotel front-desk inbox
# ETIMS_ENVIRONMENT=disabled         # never mock/production outside certification
# ETIMS_TIN=
# ETIMS_BRANCH_ID=00
# ETIMS_DEVICE_SERIAL=
# ETIMS_BASE_URL=
# ETIMS_COMMUNICATION_KEY=
# ETIMS_SALES_INVOICE_PATH=
